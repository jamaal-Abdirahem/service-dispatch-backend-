# MongoDB Atlas Connection String
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.mongodb.net/serviceDispatch?retryWrites=true&w=majority"

# JWT Secret — use a long random string in production (e.g. openssl rand -hex 64)
JWT_SECRET="your_secret_here"

# Frontend URL for CORS explicitly allowed origins
FRONTEND_URL="http://localhost:3000"

# Server port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# bcrypt salt rounds — use 10 for dev, 12 for production
BCRYPT_ROUNDS=10
